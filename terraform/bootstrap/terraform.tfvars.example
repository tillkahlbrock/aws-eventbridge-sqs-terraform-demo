region           = "eu-central-1"
platform_profile = "platform-account"
fulfillment_profile = "fulfillment-service-account"

# GitHub issues the subject claim with numeric owner and repository ids.
# Read them with: gh api repos/OWNER/NAME --jq '.owner.id, .id'
github_subject_patterns = [
  "repo:my-org@1234567/my-repo@89012345:*",
]
