# Terraform
# The dependency lock files are tracked. One pipeline applies every stack,
# so the provider version must be reproducible.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraformrc
terraform.rc

# Local variable files. Only the *.example files are tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local tooling artifacts
.memsearch/
:memory:.ses
.DS_Store

# Node
node_modules/
